{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "../../.claude/hooks/agenda-gate.sh", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write|search_replace|run_terminal_command|Write|Edit|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "./shim.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "run_terminal_command|Bash|use_tool|google_calendar.*|google-calendar.*",
        "hooks": [
          { "type": "command", "command": "../../.claude/hooks/agenda-gate.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write|search_replace|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "./shim.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "run_terminal_command|Bash|use_tool|google_calendar.*|google-calendar.*",
        "hooks": [
          { "type": "command", "command": "../../.claude/hooks/agenda-gate.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "./shim.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
